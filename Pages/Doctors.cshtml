@page
@model ClinicManagementWeb.Pages.DoctorsModel

@{
    ViewData["Title"] = "Doctor Management";
    var isEditing = Model.DoctorId > 0;
    var doctorCount = Model.Doctors.Count;
}

<div class="clinic-doctors-page">

    <div class="doctor-page-header">
        <div class="doctor-heading-copy">
            <div class="doctor-breadcrumb">
                <span>CAREPOINT</span>
                <span>/</span>
                <span>DOCTOR MANAGEMENT</span>
            </div>

            <h1>Doctors</h1>
            <p>Manage your clinic's medical professionals and their contact information.</p>
        </div>

        <div class="doctor-header-stat">
            <div class="doctor-stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="10" cy="7" r="4"/>
                    <path d="M20 8v6m-3-3h6"/>
                </svg>
            </div>
            <div class="doctor-stat-copy">
                <span>Registered doctors</span>
                <strong>@doctorCount</strong>
                <small>Clinic directory</small>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success doctor-alert alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger doctor-alert alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger doctor-alert" role="alert">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <!-- Registration / edit form -->
    <section class="doctor-panel mb-4">
        <div class="doctor-panel-header">
            <div class="doctor-panel-heading">
                <div class="doctor-panel-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 5v14m-7-7h14"/>
                    </svg>
                </div>
                <div>
                    <span class="doctor-section-label">DOCTOR DETAILS</span>
                    <h2>@(isEditing ? "Edit Doctor" : "Register a Doctor")</h2>
                    <p>
                        @(isEditing
                            ? "Update this doctor's information."
                            : "Add a medical professional to your clinic directory.")
                    </p>
                </div>
            </div>

            @if (isEditing)
            {
                <span class="doctor-edit-badge">Editing record #@Model.DoctorId</span>
            }
        </div>

        <div class="doctor-form-body">
            <form method="post"
                  asp-page-handler="@(isEditing ? "Update" : null)">

                <input type="hidden" asp-for="DoctorId" />

                <div class="doctor-form-section-label">Professional information</div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.Name" class="form-label">
                            Doctor name <span class="doctor-required">*</span>
                        </label>
                        <input asp-for="Input.Name"
                               class="form-control"
                               placeholder="Enter doctor's full name"
                               autocomplete="name"
                               required />
                        <span asp-validation-for="Input.Name"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Specialization" class="form-label">
                            Specialization
                        </label>
                        <input asp-for="Input.Specialization"
                               class="form-control"
                               placeholder="e.g. General Practice" />
                        <span asp-validation-for="Input.Specialization"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Phone" class="form-label">
                            Phone number
                        </label>
                        <input asp-for="Input.Phone"
                               class="form-control"
                               type="tel"
                               placeholder="Enter phone number"
                               autocomplete="tel" />
                        <span asp-validation-for="Input.Phone"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Email" class="form-label">
                            Email address
                        </label>
                        <input asp-for="Input.Email"
                               class="form-control"
                               type="email"
                               placeholder="doctor@example.com"
                               autocomplete="email" />
                        <span asp-validation-for="Input.Email"
                              class="text-danger small"></span>
                    </div>
                </div>

                <div class="doctor-form-footer">
                    <p><span>*</span> Required field</p>

                    <div class="d-flex flex-wrap gap-2">
                        @if (isEditing)
                        {
                            <a asp-page="/Doctors"
                               class="btn doctor-cancel-btn">
                                Cancel
                            </a>
                        }

                        <button type="submit" class="btn doctor-save-btn">
                            @if (isEditing)
                            {
                                <span>Update Doctor</span>
                            }
                            else
                            {
                                <span>Save Doctor</span>
                            }
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <!-- Doctor directory -->
    <section class="doctor-panel">
        <div class="doctor-directory-header">
            <div class="doctor-directory-title">
                <span class="doctor-section-label">CLINIC DIRECTORY</span>
                <h2>Doctor Records</h2>
                <p>View, search, and manage registered doctors.</p>
            </div>

            @if (doctorCount > 0)
            {
                <div class="doctor-directory-tools">
                    <label class="doctor-search-box" for="doctorTableSearch">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"/>
                            <path d="m20 20-4-4"/>
                        </svg>
                        <input id="doctorTableSearch"
                               type="search"
                               placeholder="Search doctors..."
                               autocomplete="off"
                               aria-label="Search doctors by name, ID, specialization, phone, or email" />
                        <kbd id="doctorSearchShortcut">Ctrl F</kbd>
                    </label>

                    <span class="doctor-record-count">
                        <span id="doctorVisibleCount">@doctorCount</span> / @doctorCount
                    </span>
                </div>
            }
        </div>

        @if (doctorCount == 0)
        {
            <div class="doctor-empty-state">
                <div class="doctor-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="10" cy="7" r="4"/>
                        <path d="M3 21v-2a7 7 0 0 1 14 0v2"/>
                        <path d="M19 8v6m-3-3h6"/>
                    </svg>
                </div>
                <h3>No doctors registered yet</h3>
                <p>Register your first doctor using the form above. Their details will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive doctor-table-container">
                <table class="table doctor-table align-middle mb-0"
                       id="doctorRecordsTable">
                    <thead>
                        <tr>
                            <th class="doctor-id-column">ID</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th class="doctor-actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model.Doctors)
                        {
                            <tr>
                                <td class="doctor-id-cell">
                                    <span>@doctor.DoctorId</span>
                                </td>
                                <td>
                                    <div class="doctor-identity">
                                        <div class="doctor-avatar" aria-hidden="true">
                                            @(!string.IsNullOrWhiteSpace(doctor.Name)
                                                ? doctor.Name.Trim().Substring(0, 1).ToUpperInvariant()
                                                : "?")
                                        </div>
                                        <span class="doctor-name">
                                            @(string.IsNullOrWhiteSpace(doctor.Name)
                                                ? "Unnamed doctor"
                                                : doctor.Name)
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(doctor.Specialization))
                                    {
                                        <span class="doctor-empty-value">Not specified</span>
                                    }
                                    else
                                    {
                                        <span class="doctor-specialty">
                                            @doctor.Specialization
                                        </span>
                                    }
                                </td>
                                <td class="doctor-phone-cell">
                                    @(string.IsNullOrWhiteSpace(doctor.Phone)
                                        ? "—"
                                        : doctor.Phone)
                                </td>
                                <td class="doctor-email-cell">
                                    @(string.IsNullOrWhiteSpace(doctor.Email)
                                        ? "—"
                                        : doctor.Email)
                                </td>
                                <td>
                                    <div class="doctor-row-actions">
                                        <form method="post"
                                              asp-page-handler="Edit"
                                              asp-route-id="@doctor.DoctorId">
                                            <button type="submit"
                                                    class="btn doctor-edit-btn">
                                                Edit
                                            </button>
                                        </form>

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              asp-route-id="@doctor.DoctorId"
                                              onsubmit="return confirm('Are you sure you want to delete this doctor?');">
                                            <button type="submit"
                                                    class="btn doctor-delete-btn">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="doctor-no-results" id="doctorNoResults" hidden>
                <h3>No matching doctors</h3>
                <p>Try another name, ID, specialization, phone number, or email.</p>
                <button type="button"
                        class="btn doctor-clear-search"
                        id="doctorClearSearch">
                    Clear search
                </button>
            </div>

            <div class="doctor-directory-footer">
                <span>
                    Showing <strong id="doctorFooterVisibleCount">@doctorCount</strong>
                    of <strong>@doctorCount</strong> doctors
                </span>
                <span class="doctor-directory-footer-note">
                    Doctor information is managed through this directory.
                </span>
            </div>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("doctorTableSearch");
            const table = document.getElementById("doctorRecordsTable");

            if (!searchInput || !table) {
                return;
            }

            const rows = Array.from(table.querySelectorAll("tbody tr"));
            const visibleCount = document.getElementById("doctorVisibleCount");
            const footerVisibleCount = document.getElementById("doctorFooterVisibleCount");
            const noResults = document.getElementById("doctorNoResults");
            const clearButton = document.getElementById("doctorClearSearch");
            const tableContainer = table.closest(".doctor-table-container");
            const shortcutLabel = document.getElementById("doctorSearchShortcut");

            if (shortcutLabel) {
                shortcutLabel.textContent =
                    navigator.platform.toLowerCase().includes("mac")
                        ? "⌘ F"
                        : "Ctrl F";
            }

            function filterDoctors() {
                const query = searchInput.value.trim().toLowerCase();
                let shown = 0;

                rows.forEach(function (row) {
                    const matches = row.textContent.toLowerCase().includes(query);
                    row.hidden = !matches;

                    if (matches) {
                        shown++;
                    }
                });

                if (visibleCount) {
                    visibleCount.textContent = shown;
                }

                if (footerVisibleCount) {
                    footerVisibleCount.textContent = shown;
                }

                if (noResults) {
                    noResults.hidden = shown !== 0;
                }

                if (tableContainer) {
                    tableContainer.hidden = shown === 0;
                }
            }

            searchInput.addEventListener("input", filterDoctors);

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    searchInput.value = "";
                    filterDoctors();
                    searchInput.focus();
                });
            }

            document.addEventListener("keydown", function (event) {
                if ((event.metaKey || event.ctrlKey) &&
                    event.key.toLowerCase() === "f") {
                    event.preventDefault();
                    searchInput.focus();
                    searchInput.select();
                }

                if (event.key === "Escape" &&
                    document.activeElement === searchInput) {
                    searchInput.value = "";
                    filterDoctors();
                }
            });
        });
    </script>
}