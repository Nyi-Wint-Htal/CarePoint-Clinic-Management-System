
@page
@model ClinicManagementWeb.Pages.PatientsModel

@{
    ViewData["Title"] = "Patient Management";
    var patientCount = Model.Patients.Count;
}

<div class="container py-4 py-lg-5 clinic-patients-page">

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show patient-alert"
             role="alert">
            <strong>Success:</strong> @successMessage
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show patient-alert"
             role="alert">
            <strong>Notice:</strong> @errorMessage
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page heading -->
    <section class="patient-page-header">
        <div class="patient-heading-copy">
            <div class="patient-breadcrumb">
                <span>CAREPOINT</span>
                <span aria-hidden="true">/</span>
                <span>Patient directory</span>
            </div>

            <h1>Patients</h1>
            <p>
                Manage patient profiles, contact details, and registration records.
            </p>
        </div>

        <div class="patient-header-stat">
            <div class="patient-stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="10" cy="7" r="4"/>
                    <path d="M20 8v6m-3-3h6"/>
                </svg>
            </div>
            <div class="patient-stat-copy">
                <span>Total registered</span>
                <strong>@patientCount</strong>
                <small>Patient records</small>
            </div>
        </div>
    </section>

    <!-- Registration / edit form -->
    <section class="card patient-panel patient-form-panel mb-4">
        <div class="card-header patient-panel-header">
            <div class="patient-panel-heading">
                <div class="patient-panel-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 5v14M5 12h14"/>
                    </svg>
                </div>
                <div>
                    <span class="patient-section-label">
                        @(Model.PatientId > 0 ? "UPDATE RECORD" : "PATIENT INTAKE")
                    </span>
                    <h2>
                        @(Model.PatientId > 0 ? "Edit patient" : "Register a patient")
                    </h2>
                    <p>
                        @(Model.PatientId > 0
                            ? "Update the patient's information below."
                            : "Enter the patient's details to create a new record.")
                    </p>
                </div>
            </div>

            @if (Model.PatientId > 0)
            {
                <span class="patient-edit-badge">Editing #@Model.PatientId</span>
            }
        </div>

        <div class="card-body patient-form-body">
            <form method="post"
                  asp-page-handler="@(Model.PatientId > 0 ? "Update" : null)">

                <input type="hidden" asp-for="PatientId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="patient-form-section-label">
                    Personal information
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Input.Name" class="form-label">
                            Full name <span class="patient-required">*</span>
                        </label>
                        <input asp-for="Input.Name"
                               class="form-control"
                               placeholder="Enter patient's full name"
                               autocomplete="name"
                               required />
                        <span asp-validation-for="Input.Name"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Phone" class="form-label">
                            Phone number <span class="patient-required">*</span>
                        </label>
                        <input asp-for="Input.Phone"
                               class="form-control"
                               type="tel"
                               placeholder="Enter phone number"
                               autocomplete="tel"
                               required />
                        <span asp-validation-for="Input.Phone"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.DateOfBirth" class="form-label">
                            Date of birth
                        </label>
                        <input asp-for="Input.DateOfBirth"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="Input.DateOfBirth"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Gender" class="form-label">
                            Gender <span class="patient-required">*</span>
                        </label>
                        <select asp-for="Input.Gender"
                                class="form-select"
                                required>
                            <option value="">Select gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Input.Gender"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Address" class="form-label">
                            Address <span class="patient-required">*</span>
                        </label>
                        <input asp-for="Input.Address"
                               class="form-control"
                               placeholder="Enter patient's residential address"
                               autocomplete="street-address"
                               required />
                        <span asp-validation-for="Input.Address"
                              class="text-danger small"></span>
                    </div>

                </div>

                <div class="patient-form-footer">
                    <p>
                        <span aria-hidden="true">*</span>
                        Required fields
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.PatientId > 0)
                        {
                            <a asp-page="/Patients"
                               class="btn btn-outline-secondary patient-cancel-btn">
                                Cancel
                            </a>
                        }

                        <button type="submit" class="btn patient-save-btn">
                            <span aria-hidden="true">
                                @(Model.PatientId > 0 ? "✓" : "+")
                            </span>
                            @(Model.PatientId > 0 ? "Update patient" : "Save patient")
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <!-- Patient directory -->
    <section class="card patient-panel patient-directory-panel">
        <div class="card-header patient-directory-header">
            <div class="patient-directory-title">
                <span class="patient-section-label">RECORDS</span>
                <h2>Patient directory</h2>
                <p>Search and manage registered patients.</p>
            </div>

            <div class="patient-directory-tools">
                <label class="patient-search-box">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"/>
                        <path d="m16 16 4 4"/>
                    </svg>
                    <input type="search"
                           id="patientTableSearch"
                           placeholder="Search patients..."
                           autocomplete="off"
                           aria-label="Search patient records" />
                    <kbd id="patientSearchShortcut">Ctrl F</kbd>
                </label>

                <span class="patient-record-count"
                      id="patientVisibleCount"
                      aria-live="polite">
                    @patientCount records
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (patientCount == 0)
            {
                <div class="patient-empty-state">
                    <div class="patient-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="10" cy="7" r="4"/>
                            <path d="M20 8v6m-3-3h6"/>
                        </svg>
                    </div>
                    <h3>No patients registered yet</h3>
                    <p>
                        Your patient directory is empty. Use the registration
                        form above to add your first patient.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table id="patientRecordsTable"
                           class="table patient-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="patient-id-column">Patient ID</th>
                                <th scope="col">Patient</th>
                                <th scope="col">Date of birth</th>
                                <th scope="col">Gender</th>
                                <th scope="col">Phone</th>
                                <th scope="col">Address</th>
                                <th scope="col" class="patient-actions-column">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                        @foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <td class="patient-id-cell">
                                    <span>#@patient.PatientId</span>
                                </td>

                                <td>
                                    <div class="patient-identity">
                                        <div class="patient-avatar" aria-hidden="true">
                                            @(string.IsNullOrWhiteSpace(patient.Name)
                                                ? "?"
                                                : patient.Name.Trim().Substring(0, 1).ToUpperInvariant())
                                        </div>
                                        <span class="patient-name">
                                            @patient.Name
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @(patient.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(patient.Gender))
                                    {
                                        <span class="patient-gender-badge">
                                            @patient.Gender
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="patient-empty-value">—</span>
                                    }
                                </td>

                                <td class="patient-phone-cell">
                                    @(string.IsNullOrWhiteSpace(patient.Phone)
                                        ? "—"
                                        : patient.Phone)
                                </td>

                                <td class="patient-address-cell">
                                    @(string.IsNullOrWhiteSpace(patient.Address)
                                        ? "—"
                                        : patient.Address)
                                </td>

                                <td>
                                    <div class="patient-row-actions">
                                        <form method="post"
                                              asp-page-handler="Edit"
                                              asp-route-id="@patient.PatientId">
                                            <button type="submit"
                                                    class="btn patient-edit-btn">
                                                Edit
                                            </button>
                                        </form>

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              asp-route-id="@patient.PatientId"
                                              onsubmit="return confirm('Are you sure you want to delete this patient?');">
                                            <button type="submit"
                                                    class="btn patient-delete-btn">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="patient-no-results" id="patientNoResults" hidden>
                    <div class="patient-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="7"/>
                            <path d="m16 16 4 4"/>
                        </svg>
                    </div>
                    <h3>No matching patients</h3>
                    <p>Try another name, patient ID, phone number, or address.</p>
                    <button type="button"
                            class="btn patient-clear-search"
                            id="clearPatientSearch">
                        Clear search
                    </button>
                </div>
            }
        </div>

        @if (patientCount > 0)
        {
            <div class="card-footer patient-directory-footer">
                <span>
                    Displaying <strong id="patientFooterVisibleCount">@patientCount</strong>
                    of <strong>@patientCount</strong> patient records
                </span>
                <span class="patient-directory-footer-note">
                    Patient information
                </span>
            </div>
        }
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            const searchInput = document.getElementById("patientTableSearch");
            const table = document.getElementById("patientRecordsTable");
            const visibleCount = document.getElementById("patientVisibleCount");
            const footerCount = document.getElementById("patientFooterVisibleCount");
            const noResults = document.getElementById("patientNoResults");
            const clearButton = document.getElementById("clearPatientSearch");
            const shortcutLabel = document.getElementById("patientSearchShortcut");

            if (shortcutLabel) {
                shortcutLabel.textContent =
                    navigator.platform.toLowerCase().includes("mac")
                        ? "⌘ F"
                        : "Ctrl F";
            }

            if (!searchInput || !table) return;

            const rows = Array.from(table.querySelectorAll("tbody tr"));
            const totalCount = rows.length;

            function filterPatients() {
                const query = searchInput.value.trim().toLowerCase();
                let shown = 0;

                rows.forEach(row => {
                    const matches = row.textContent.toLowerCase().includes(query);
                    row.hidden = !matches;

                    if (matches) shown++;
                });

                if (visibleCount) {
                    visibleCount.textContent = query
                        ? `${shown} of ${totalCount} records`
                        : `${totalCount} records`;
                }

                if (footerCount) {
                    footerCount.textContent = shown;
                }

                if (noResults) {
                    noResults.hidden = shown !== 0;
                }

                const tableContainer = table.closest(".table-responsive");

                if (tableContainer) {
                    tableContainer.hidden = shown === 0;
                }
            }

            searchInput.addEventListener("input", filterPatients);

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    searchInput.value = "";
                    filterPatients();
                    searchInput.focus();
                });
            }

            document.addEventListener("keydown", function (event) {
                const isFindShortcut =
                    (event.metaKey || event.ctrlKey) &&
                    event.key.toLowerCase() === "f";

                if (isFindShortcut) {
                    event.preventDefault();
                    searchInput.focus();
                    searchInput.select();
                }

                if (event.key === "Escape" &&
                    document.activeElement === searchInput) {
                    searchInput.value = "";
                    filterPatients();
                }
            });
        });
    </script>
}
