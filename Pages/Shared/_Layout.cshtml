
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicManagementWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicManagementWeb.styles.css" asp-append-version="true" />
</head>
<body>

<header>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    }

    <nav class="navbar navbar-expand-xl clinic-navbar">
        <div class="container-fluid px-lg-4">

            <!-- Brand -->
            <a class="navbar-brand clinic-brand" asp-page="/Index">
                <span class="clinic-brand-icon">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="26" height="26" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/>
                        <path d="M12 8v8M8 12h8"/>
                    </svg>
                </span>
                <span class="clinic-brand-text">
                    <span class="clinic-brand-name">CarePoint</span>
                    <span class="clinic-brand-subtitle">CLINIC MANAGEMENT</span>
                </span>
            </a>

            <!-- Mobile menu button -->
            <button class="navbar-toggler clinic-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation links -->
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav clinic-nav ms-xl-auto">

                    <li class="nav-item">
                        <a class="nav-link @(currentPage == "/Index" ? "active" : "")"
                           asp-page="/Index"
                           aria-current="@(currentPage == "/Index" ? "page" : null)">
                            <span class="clinic-nav-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                                    <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                                    <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                                    <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                                </svg>
                            </span>
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentPage == "/Patients" ? "active" : "")"
                           asp-page="/Patients"
                           aria-current="@(currentPage == "/Patients" ? "page" : null)">
                            <span class="clinic-nav-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="10" cy="7" r="4"/>
                                    <path d="M20 8v6m-3-3h6"/>
                                </svg>
                            </span>
                            Patients
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentPage == "/Doctors" ? "active" : "")"
                           asp-page="/Doctors"
                           aria-current="@(currentPage == "/Doctors" ? "page" : null)">
                            <span class="clinic-nav-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M8 3v5a4 4 0 0 0 8 0V3"/>
                                    <path d="M6 3h4m4 0h4"/>
                                    <path d="M12 12v3a4 4 0 0 0 8 0v-1"/>
                                    <circle cx="20" cy="12" r="1"/>
                                    <path d="M12 15a4 4 0 1 1-8 0v-3"/>
                                </svg>
                            </span>
                            Doctors
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentPage == "/Appointments" ? "active" : "")"
                           asp-page="/Appointments"
                           aria-current="@(currentPage == "/Appointments" ? "page" : null)">
                            <span class="clinic-nav-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                                    <path d="M16 3v4M8 3v4M3 11h18"/>
                                    <path d="m9 16 2 2 4-4"/>
                                </svg>
                            </span>
                            Appointments
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentPage == "/MedicalHistory" ? "active" : "")"
                           asp-page="/MedicalHistory"
                           aria-current="@(currentPage == "/MedicalHistory" ? "page" : null)">
                            <span class="clinic-nav-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M4 4h16v16H4z"/>
                                    <path d="M12 8v8M8 12h8"/>
                                </svg>
                            </span>
                            Medical History
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentPage == "/Medicines" ? "active" : "")"
                           asp-page="/Medicines"
                           aria-current="@(currentPage == "/Medicines" ? "page" : null)">
                            <span class="clinic-nav-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m10 3 11 11a5 5 0 0 1-7 7L3 10a5 5 0 0 1 7-7z"/>
                                    <path d="m8 8 8 8"/>
                                </svg>
                            </span>
                            Medicines
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentPage == "/Prescriptions" ? "active" : "")"
                           asp-page="/Prescriptions"
                           aria-current="@(currentPage == "/Prescriptions" ? "page" : null)">
                            <span class="clinic-nav-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M8 3h8l4 4v14H4V3z"/>
                                    <path d="M16 3v5h4M8 13h8M8 17h6"/>
                                    <path d="M8 9h2"/>
                                </svg>
                            </span>
                            Prescriptions
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted mt-4">
    <div class="container py-3">
        &copy; @DateTime.Now.Year - ClinicManagementWeb
        | <a asp-page="/Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
